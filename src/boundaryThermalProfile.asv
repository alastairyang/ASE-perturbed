function T_func = boundaryThermalProfile(md, ghf, Ts, smb, outflux_bound, solver)
%BOUNDARYTHERMALPROFILE create temperature profiles at the influx boundary 
%
%   Parameter:
%       md:  issm model class (3D)
%       ghf: geothermal heat flux (2D)
%       Ts:  surface temperature (2D)
%       smb: surface mass balaance (2D)
%       outflux_bound: Nx2 (x,y) defining the boundary of a polygon that
%                      encloses all the outflux nodes. We exclude these
%                      nodes / vertices in the thermal profile solutions
%       solver: either "bvp4c" or "FD" where FD is finite difference
%
%   Return:
%       T_func: a scatteredInterpolant function that takes in (x,y,z)
%               and output the temperature solution

    % get the boundary vertices at the base
    basebound_idx = find(md.mesh.vertexonbase & md.mesh.vertexonboundary);
    surfbound_idx = find(md.mesh.vertexonsurface & md.mesh.vertexonboundary);
    
    xb = md.mesh.x(basebound_idx);
    yb = md.mesh.y(basebound_idx);
    zs = md.mesh.z(surfbound_idx);
    zb = md.mesh.z(basebound_idx);

    influx = ~inpolygon(xb, yb, outflux_bound(:,1), outflux_bound(:,2));
    influx_bound_idx = basebound_idx(influx);

    % remove the nodes on the outflux boundary
    xb = xb(influx_bound_idx);
    yb = yb(influx_bound_idx);
    zs = zs(influx_bound_idx);
    zb = zb(influx_bound_idx);

    H_bc = zs - zb;

    if numel(ghf) > md.mesh.numberofvertices2d; error("Expect 2d GHF input"); end
    if numel(Ts)  > md.mesh.numberofvertices2d; error("Expect 2d Ts input"); end
    if numel(smb) > md.mesh.numberofvertices2d; error("Expect 2d SMB input"); end

    GHF_bc = ghf;
    smb_bc = smb;
    Ts_bc  = Ts;
    
    % get temperature at influx boundaries
    % Parameters you do not need to change
    dsdx = 0.0001; % surface slope (only useful for non-ice-shelf; turned off)
    u = 0; % m/a, along-flow velocity
    bm = 0; 
    dz_ref = 10; % m, spacing
    dTdx = 0; % horizontal temperature gradient

    % create a thermal mode
    n_idx = numel(influx_bound_idx);

    z_vec = cell(n_idx,1);
    T_vec = cell(n_idx,1);

    for jj = 1:n_idx
        idx = influx_bound_idx(jj);
        if H_bc(jj) <= dz_ref % if thickness is smaller than ref interval
            dz = H_bc(jj)*0.2;
        else
            dz = dz_ref;
        end
        tmd = thermal1d(H_bc(idx), dsdx, dz, smb_bc(idx), bm, Ts_bc(idx), GHF_bc(idx), u, dTdx, "DJ", solver);
        % tmd = tmd.solveNonlinearGI();
        tmd = tmd.solveNonlinearGI();

        z_vec{jj} = tmd.sol.x;
        T_vec{jj} = tmd.sol.y(1,:);
    end

    % construct coords
    coords_md = [];
    temp_md = [];
    for jj = 1:n_idx
        % collect coordinates
        xv = repmat(xb(jj), numel(z_vec{jj}),1);
        yv = repmat(yb(jj), numel(z_vec{jj}),1);
        coords_temp = [xv, yv, zb(jj) + transpose(z_vec{jj})];
        coords_md = [coords_md; coords_temp];

        % collect temperature
        temp_md = [temp_md; transpose(T_vec{jj})];
    end

    % concat all coordinates and temperature to create an
    % interpolant
    T_func = scatteredInterpolant(coords_md(:,1),...
                                         coords_md(:,2),...
                                         coords_md(:,3),...
                                         temp_md);
    
end